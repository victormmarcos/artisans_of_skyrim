#pragma once

// String literal form, for joining with other literals at compile time.
#define AOS_VERSION_STRING "@PROJECT_VERSION@"

// Generated by CMake. The version is set only in CMakeLists.txt (project VERSION).
namespace AOS::Version
{
    inline constexpr unsigned short kMajor = @AOS_VERSION_MAJOR@;
    inline constexpr unsigned short kMinor = @AOS_VERSION_MINOR@;
    inline constexpr unsigned short kPatch = @AOS_VERSION_PATCH@;
    inline constexpr const char* kString = "@PROJECT_VERSION@";
}
